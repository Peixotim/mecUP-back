NODE_ENV=development
API_PORT=8080

POSTGRES_USER=mecup
POSTGRES_PASSWORD=troque-esta-senha-postgres
POSTGRES_DB=mecup
POSTGRES_PORT=5432
# Host de conexão: "postgres" dentro do Docker / "localhost" fora dele
POSTGRES_HOST=postgres

DATABASE_URL=postgresql://mecup:troque-esta-senha-postgres@postgres:5432/mecup?schema=public
REDIS_PASSWORD=troque-esta-senha-redis
REDIS_PORT=6379
# Host de conexão: "redis" dentro do Docker / "localhost" fora dele
REDIS_HOST=redis
REDIS_URL=redis://:troque-esta-senha-redis@redis:6379


# URL(s) do frontend liberadas no CORS. Separe múltiplas origens por vírgula.
FRONTEND_URL=http://localhost:3000

# true somente se o frontend enviar cookies/credenciais nas requisições
CORS_CREDENTIALS=false

# Em quem o Express confia para os headers X-Forwarded-* (req.ip real atrás de proxy).
# "false" em dev. Em produção use o nº de proxies à frente da API (ex: 1) — evite "true".
TRUST_PROXY=false

RATE_LIMIT_MAX=100

RATE_LIMIT_WINDOW=60

# Tamanho máximo do pool de conexões do Postgres. Opcional (default 10).
DB_POOL_MAX=10

# JWT — Access e Refresh DEVEM ter segredos distintos (mín. 32 caracteres).
# Gere com: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=troque-este-secret-de-access-com-32-caracteres-ou-mais
JWT_REFRESH_SECRET=troque-este-secret-de-refresh-com-32-caracteres-ou-mais
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d
